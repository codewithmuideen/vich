# Copy this file to .env.local (gitignored) and fill in your Supabase
# project's values: Supabase Dashboard > Project Settings > API.
# The anon key is safe to expose in frontend code, since it only grants what
# Row Level Security in supabase/migrations allows an anonymous visitor.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push public key (safe to expose, since it's the "public" half of the
# VAPID keypair). Generate the pair once and set the private half as a
# Supabase secret; see DEPLOYMENT.md for the exact steps.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
