# Copy this file to .env.local (gitignored) and fill in your Supabase
# project's values: Supabase Dashboard > Project Settings > API.
# The anon key is safe to expose in frontend code — it only grants what
# Row Level Security in supabase/migrations allows an anonymous visitor.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
